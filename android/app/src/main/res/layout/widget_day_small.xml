<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <ImageView
            android:id="@+id/w_dial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:fontFamily="sans-serif-medium" android:text="rămase" />
            <TextView android:id="@+id/w_num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="26sp" android:textStyle="bold" android:fontFamily="sans-serif-black" android:letterSpacing="-0.02" android:maxLines="1" android:text="–" />
            <TextView android:id="@+id/w_of" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10.5sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
