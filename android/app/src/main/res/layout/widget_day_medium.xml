<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9">

            <ImageView
                android:id="@+id/w_dial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10.5sp" android:fontFamily="sans-serif-medium" android:text="rămase" />
                <TextView android:id="@+id/w_num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="23sp" android:textStyle="bold" android:fontFamily="sans-serif-black" android:letterSpacing="-0.02" android:maxLines="1" android:text="–" />
                <TextView android:id="@+id/w_of" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.25"
            android:layout_marginStart="14dp"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/w_p_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="9sp" android:layout_marginEnd="5dp" />
                <TextView android:id="@+id/w_p_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                <TextView android:id="@+id/w_p_val" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:maxLines="1" />
            </LinearLayout>
            <ImageView android:id="@+id/w_p_bar" android:layout_width="match_parent" android:layout_height="6dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="10dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/w_c_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="9sp" android:layout_marginEnd="5dp" />
                <TextView android:id="@+id/w_c_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                <TextView android:id="@+id/w_c_val" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:maxLines="1" />
            </LinearLayout>
            <ImageView android:id="@+id/w_c_bar" android:layout_width="match_parent" android:layout_height="6dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="10dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/w_f_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="9sp" android:layout_marginEnd="5dp" />
                <TextView android:id="@+id/w_f_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                <TextView android:id="@+id/w_f_val" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:maxLines="1" />
            </LinearLayout>
            <ImageView android:id="@+id/w_f_bar" android:layout_width="match_parent" android:layout_height="6dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="0dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
